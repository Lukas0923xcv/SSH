# Rendered by the nginx image's envsubst entrypoint into /etc/nginx/conf.d/default.conf.
# Only variables matching NGINX_ENVSUBST_FILTER (^WEBSSH_) are substituted, so every
# ${WEBSSH_*} below is a literal value by the time Nginx parses this file; Nginx
# variables such as $http_host are left untouched.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# 1. Host allowlist (DNS-rebinding protection)
# Strip an optional port, then accept only the configured names. A rebound attacker
# domain sends its own name as Host and is rejected here.
# Supports standard domains, IPv4 addresses, and bracketed IPv6 addresses ([::1]).
map $http_host $host_clean {
    default "";
    "~*^(?<hh>\[[0-9a-fA-F:]+\]|[^:/\[\]]+)(?::[0-9]+)?$" $hh;
}

map $host_clean $host_allowed {
    default                  0;
    "localhost"              1;
    "127.0.0.1"              1;
    "[::1]"                  1;
    "${WEBSSH_PUBLIC_HOST}"  1;
}

# 2. Exact Origin allowlist (Cross-Site WebSocket Hijacking protection)
# The full origin (scheme + host + port) must match. Other ports or schemes on the
# same host, sandboxed iframes ("Origin: null") and foreign sites are rejected.
map $http_origin $origin_allowed {
    default                                 0;
    ""                                      1;  # No Origin: top-level navigation, curl, CLI
    "https://${WEBSSH_PUBLIC_HOST}"         1;  # Cloudflare Tunnel public hostname
    "http://127.0.0.1:${WEBSSH_PORT}"       1;  # Local access
    "http://localhost:${WEBSSH_PORT}"       1;  # Local access
    "http://[::1]:${WEBSSH_PORT}"           1;  # Local access (IPv6)
}

map "$host_allowed$origin_allowed" $request_allowed {
    default 0;
    "11"    1;
}

# Rate & Connection Limiting Zone (per client IP)
limit_conn_zone $binary_remote_addr zone=webssh_conn_limit:10m;
limit_conn_status 429;

server {
    listen 8888;
    server_name _;
    server_tokens off;
    client_max_body_size 1k;

    # ttyd serves its ~720 KB web client uncompressed; compress it (~4x smaller, faster first load).
    # JSON (e.g. /token) is intentionally excluded.
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css application/javascript;

    # Limit concurrent connections per IP address (DoS mitigation)
    limit_conn webssh_conn_limit 10;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; img-src 'self' data:; frame-ancestors 'self';" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location / {
        # Block unknown Host names (DNS rebinding) and cross-origin WebSocket hijacking attempts
        if ($request_allowed = 0) {
            return 403 "Forbidden: Host or Origin not allowed.\n";
        }

        # Application-level login, independent of Cloudflare Access and the bind address.
        # Fails closed: if the credential file is missing, every request is refused.
        auth_basic "Web SSH Center";
        auth_basic_user_file /etc/nginx/webssh.htpasswd;

        proxy_pass http://ttyd:7681;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
