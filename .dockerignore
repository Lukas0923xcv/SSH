# Exclude runtime and user data
data/
*.tmp
*.log
*.db*
*.sqlite*
.DS_Store

# Exclude credentials and private keys
*.pem
*.key
*.ppk
*.pfx
*.p12
*.p8
id_*
known_hosts*
authorized_keys*

# Exclude environment files
.env
.env.*
!.env.example

# Exclude version control and agent artifacts
.git/
.gitignore
.gitattributes
.agents/
