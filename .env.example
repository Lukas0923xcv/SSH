# Optional: Cloudflare Zero Trust Tunnel Token
# If running cloudflared inside Docker, set your token here and run:
# docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Host IP and port binding (default: 127.0.0.1:8888)
# Keep 127.0.0.1 so the web terminal cannot be accessed directly over the public internet,
# ensuring all remote access is routed through your Cloudflare Tunnel with MFA / Access policy.
WEBSSH_BIND_IP=127.0.0.1
WEBSSH_PORT=8888
